# ====== DeepSeek（聊天模型）======
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ====== SiliconFlow（BGE-M3 Embedding）======
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ====== Milvus ======
# 本地开发跑在宿主机时用 localhost；docker-compose 内会自动覆盖为 http://milvus:19530
MILVUS_URI=http://localhost:19530
DB_NAME=rag_tutorial
COLLECTION_NAME=docs

# ====== Postgres（长期记忆）======
# 本地开发跑在宿主机时用 localhost；docker-compose 内会自动覆盖为 postgres 服务名
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/memory
